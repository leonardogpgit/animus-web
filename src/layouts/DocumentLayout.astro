---
import BaseLayout from './BaseLayout.astro';
import TableOfContents from '../components/TableOfContents.astro';
import type { MarkdownHeading } from 'astro';

interface Props {
  title: string;
  description: string;
  lastUpdated?: string;
  headings?: MarkdownHeading[];
}

const { title, description, lastUpdated = 'October 2026', headings = [] } = Astro.props;
---

<BaseLayout title={title} description={description}>
  <div class="py-10 md:py-16">
    <div class="container mx-auto px-4 sm:px-6 lg:px-8 max-w-5xl">
      <!-- Header Card matching legal/manifesto format -->
      <div class="relative mb-10 overflow-hidden rounded-2xl border border-slate-300 bg-[#f4f7fb] px-8 py-10 shadow-sm dark:border-white/10 dark:bg-white/5 md:px-14 md:py-12 transition-colors">
        <h1 class="mb-3 text-3xl sm:text-4xl md:text-5xl font-display font-black tracking-tight text-black dark:text-white">
          {title}
        </h1>
        {lastUpdated && (
          <p class="text-sm text-black/60 dark:text-white/60 font-sans">
            Last updated: {lastUpdated}
          </p>
        )}
      </div>

      <!-- Content Area with TOC -->
      <div class="flex gap-12 lg:gap-16">
        <article class="min-w-0 flex-1 prose prose-slate dark:prose-invert max-w-none font-sans text-black/80 dark:text-white/80 leading-relaxed prose-headings:text-black dark:prose-headings:text-white prose-a:text-black dark:prose-a:text-white">
          <slot />
        </article>

        {headings.length > 0 && (
          <aside class="hidden xl:block w-64 shrink-0">
            <TableOfContents headings={headings} />
          </aside>
        )}
      </div>
    </div>
  </div>
</BaseLayout>

---
import { NAV_LINKS, BRAND_NAME, BRAND_LOGO_TEXT } from '../config';
import { resolvePath } from '../utils/navigation';
---

<header class="sticky top-0 z-50 w-full border-b border-slate-300 bg-[#dfe6ee]/90 backdrop-blur-xl dark:border-slate-800 dark:bg-[#09090b]/80">
  <div class="mx-auto max-w-6xl px-4 sm:px-6 lg:px-8">
    <div class="flex h-14 items-center justify-between md:h-16">
      <!-- Logo -->
      <a href={resolvePath('/')} class="flex items-center gap-3" aria-label="Go to home">
        <div class="flex h-9 w-9 items-center justify-center rounded-xl bg-indigo-600 text-lg font-bold text-white shadow-sm shadow-indigo-500/30">
          {BRAND_LOGO_TEXT}
        </div>
        <span class="font-descscor text-xl font-bold tracking-tight text-black dark:text-white">
          {BRAND_NAME}
        </span>
      </a>

      <!-- Desktop Navigation -->
      <nav class="hidden items-center gap-7 md:flex">
        {NAV_LINKS.map(link => (
          <a href={resolvePath(link.href)} class="text-sm font-medium text-black transition-colors hover:text-indigo-600 dark:text-white dark:hover:text-indigo-400">
            {link.label}
          </a>
        ))}
      </nav>

      <!-- Theme Toggle (Desktop & Mobile) -->
      <div class="flex items-center gap-3">
        <button
          id="theme-toggle"
          data-theme-toggle
          type="button"
          class="inline-flex h-9 w-9 items-center justify-center rounded-lg border border-slate-300 bg-[#f4f7fb] text-black shadow-xs transition-colors hover:bg-slate-200/70 dark:border-slate-700 dark:bg-slate-900 dark:text-white dark:hover:bg-slate-800"
          aria-label="Toggle theme"
        >
          <svg data-theme-dark-icon class="hidden h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path></svg>
          <svg data-theme-light-icon class="hidden h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="5"></circle><line x1="12" y1="1" x2="12" y2="3"></line><line x1="12" y1="21" x2="12" y2="23"></line><line x1="4.22" y1="4.22" x2="5.64" y2="5.64"></line><line x1="18.36" y1="18.36" x2="19.78" y2="19.78"></line><line x1="1" y1="12" x2="3" y2="12"></line><line x1="21" y1="12" x2="23" y2="12"></line><line x1="4.22" y1="19.78" x2="5.64" y2="18.36"></line><line x1="18.36" y1="5.64" x2="19.78" y2="4.22"></line></svg>
        </button>
      </div>
    </div>

    <!-- Mobile Navigation (Always visible, no hamburger) -->
    <nav class="flex flex-wrap items-center justify-center gap-x-5 gap-y-1.5 border-t border-slate-300/80 py-2.5 dark:border-slate-800/70 md:hidden">
      {NAV_LINKS.map(link => (
        <a href={resolvePath(link.href)} class="text-xs sm:text-sm font-medium text-black transition-colors hover:text-indigo-600 dark:text-white dark:hover:text-indigo-400">
          {link.label}
        </a>
      ))}
    </nav>
  </div>
</header>

<script>
  function setupTheme() {
    const storedTheme = localStorage.getItem('theme');
    if (storedTheme === 'dark' || storedTheme === 'light') {
      document.documentElement.classList.toggle('dark', storedTheme === 'dark');
    }

    function updateIcons() {
      const isDark = document.documentElement.classList.contains('dark');
      document.querySelectorAll('[data-theme-toggle]').forEach((button) => {
        button.setAttribute('aria-pressed', String(isDark));
        button.querySelector('[data-theme-dark-icon]')?.classList.toggle('hidden', isDark);
        button.querySelector('[data-theme-light-icon]')?.classList.toggle('hidden', !isDark);
      });
    }

    function toggleTheme() {
      const isDark = document.documentElement.classList.toggle('dark');
      localStorage.setItem('theme', isDark ? 'dark' : 'light');
      updateIcons();
    }

    updateIcons();

    document.querySelectorAll('[data-theme-toggle]').forEach((button) => {
      if (button.dataset.themeBound === 'true') return;
      button.dataset.themeBound = 'true';
      button.addEventListener('click', toggleTheme);
    });
  }

  // Run on initial load
  setupTheme();
  
  // Run on View Transitions page changes
  document.addEventListener('astro:page-load', () => {
    setupTheme();
  });
</script>

---
const testimonials = [
  {
    quote: "I love the reciprocity rule. You have to contribute your perspective before you can ask, and you don't see results until you commit your answer. Pure signal, zero noise.",
    author: "Carlos M., 44",
    role: "Systems Architect",
    avatar: "https://i.pravatar.cc/150?u=carlos"
  },
  {
    quote: "Finally, a platform that captures authentic human sentiment without the toxicity of comment threads. The demographic breakdown across age groups is uniquely valuable.",
    author: "Dr. Julian V.",
    role: "Sociologist & Researcher",
    avatar: "https://i.pravatar.cc/150?u=julian"
  },
  {
    quote: "It replaced my mindless scrolling habit. I answer 15 to 20 questions with my morning coffee. Quick, thought-provoking, and completely respectful of personal privacy.",
    author: "Patricia L., 39",
    role: "Educator",
    avatar: "https://i.pravatar.cc/150?u=patricia"
  }
];
---

<section id="testimonials" class="py-28 bg-white dark:bg-[#09090b] relative overflow-hidden">
  <div class="container mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
    <div class="text-center max-w-3xl mx-auto mb-20 reveal-on-scroll">
      <span class="inline-flex items-center gap-2 px-3 py-1 rounded-full border border-primary-300 dark:border-primary-500/30 bg-primary-50 dark:bg-primary-500/10 text-primary-600 dark:text-primary-400 text-xs font-semibold uppercase tracking-widest mb-4">
        Community Perspectives
      </span>
      <h2 class="text-4xl md:text-5xl font-heading font-extrabold text-slate-900 dark:text-white mb-6">Real voices. <span class="text-slate-400 dark:text-slate-500">Zero noise.</span></h2>
      <p class="text-lg sm:text-xl text-slate-600 dark:text-slate-400">
        Discover why people are replacing mindless scrolling with real, thoughtful consensus.
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-8 max-w-7xl mx-auto">
      {testimonials.map((t, index) => (
        <div class="glass-panel p-8 flex flex-col h-full reveal-on-scroll relative group" style={`transition-delay: ${index * 100}ms;`}>
          <!-- Decorative quotation mark -->
          <div class="absolute top-6 right-6 text-6xl text-slate-100 dark:text-slate-800/50 font-serif leading-none select-none">"</div>
          
          <!-- Rating stars -->
          <div class="flex gap-1 text-primary-500 mb-6 relative z-10">
            {[1, 2, 3, 4, 5].map(() => (
              <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 fill-current" viewBox="0 0 24 24"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>
            ))}
          </div>
          
          <blockquote class="text-slate-700 dark:text-slate-300 text-base sm:text-lg mb-8 flex-grow relative z-10 font-medium leading-relaxed font-sans">
            "{t.quote}"
          </blockquote>
          
          <div class="flex items-center gap-4 relative z-10">
            <div class="w-11 h-11 rounded-full bg-primary-100 dark:bg-primary-900/40 text-primary-600 dark:text-primary-300 font-bold flex items-center justify-center font-heading text-sm">
              {t.author.charAt(0)}
            </div>
            <div>
              <div class="font-bold text-slate-900 dark:text-white font-heading">{t.author}</div>
              <div class="text-xs text-slate-500 dark:text-slate-400 font-sans">{t.role}</div>
            </div>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

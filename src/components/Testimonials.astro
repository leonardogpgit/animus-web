---
const testimonials = [
  {
    quote: "I love the reciprocity rule. You have to contribute your perspective before you can ask, and you don't see results until you commit your answer. Pure signal, zero noise.",
    author: "Carlos M., 44",
    role: "Systems Architect",
    avatar: "https://i.pravatar.cc/150?u=carlos"
  },
  {
    quote: "Finally, a platform that captures authentic human sentiment without the toxicity of comment threads. The demographic breakdown across age groups is uniquely valuable.",
    author: "Dr. Julian V.",
    role: "Sociologist & Researcher",
    avatar: "https://i.pravatar.cc/150?u=julian"
  },
  {
    quote: "It replaced my mindless scrolling habit. I answer 15 to 20 questions with my morning coffee. Quick, thought-provoking, and completely respectful of personal privacy.",
    author: "Patricia L., 39",
    role: "Educator",
    avatar: "https://i.pravatar.cc/150?u=patricia"
  }
];
---

<section id="testimonials" class="pt-16 pb-8 md:pt-24 md:pb-12 bg-[#dfe6ee] dark:bg-[#09090b] border-t border-slate-300 dark:border-slate-800 relative overflow-hidden">
  <div class="container mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
    <div class="text-center max-w-3xl mx-auto mb-20 reveal-on-scroll">
      <h2 class="text-4xl md:text-5xl font-sans font-extrabold text-slate-900 dark:text-white mb-6">Real voices. <span class="text-slate-600 dark:text-slate-400">Zero noise.</span></h2>
      <p class="text-lg sm:text-xl text-slate-700 dark:text-slate-300">
        Discover why people are replacing mindless scrolling with real, thoughtful consensus.
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-8 max-w-7xl mx-auto">
      {testimonials.map((t, index) => (
        <div class="glass-panel p-8 flex flex-col h-full reveal-on-scroll relative group" style={`transition-delay: ${index * 100}ms;`}>
          <!-- Decorative quotation mark -->
          <div class="absolute top-6 right-6 text-6xl text-slate-200 dark:text-slate-800/50 font-serif leading-none select-none">"</div>
          
          <blockquote class="text-slate-700 dark:text-slate-300 text-base sm:text-lg mb-8 flex-grow relative z-10 font-medium leading-relaxed font-sans">
            "{t.quote}"
          </blockquote>
          
          <div class="flex items-center gap-4 relative z-10">
            <div class="w-11 h-11 rounded-full bg-primary-100 dark:bg-primary-900/40 text-primary-600 dark:text-primary-300 font-bold flex items-center justify-center font-sans text-sm">
              {t.author.charAt(0)}
            </div>
            <div>
              <div class="font-bold text-slate-900 dark:text-white font-sans">{t.author}</div>
              <div class="text-xs text-slate-600 dark:text-slate-400 font-sans">{t.role}</div>
            </div>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

---
import { FOOTER_LINKS, SOCIAL_LINKS } from '../config';
import { resolvePath } from '../utils/navigation';
---

<footer class="metal-slab-bar w-full transition-colors">
  <div class="mx-auto max-w-6xl px-4 sm:px-6 lg:px-8 pt-6 pb-4 md:pt-8 md:pb-5">
    <!-- Social Icons (dedicated line above legal) -->
    <div class="flex flex-wrap items-center justify-center gap-2 sm:gap-3 mb-3 md:mb-4">
      {SOCIAL_LINKS.map(item => (
        <a
          href={item.url}
          class="flex h-9 w-9 items-center justify-center rounded-lg border border-white/20 bg-black/40 text-white shadow-xs hover:bg-black/60 dark:border-black/20 dark:bg-white/40 dark:text-black dark:hover:bg-white/60 transition-colors"
          target="_blank"
          rel="noopener noreferrer"
          aria-label={item.label}
          title={item.label}
        >
          <span class="sr-only">{item.label}</span>
          <svg class="h-4 w-4" fill="currentColor" viewBox="0 0 24 24">
            <path d={item.path} />
          </svg>
        </a>
      ))}
    </div>

    <!-- Legal Links -->
    <div class="flex flex-wrap items-center justify-center gap-6">
      {FOOTER_LINKS.map(group => (
        <ul class="flex flex-wrap items-center justify-center gap-6">
          {group.links.map(link => (
            <li>
              <a href={resolvePath(link.href)} class="text-sm font-medium text-white/90 transition-opacity hover:opacity-100 dark:text-black/90 dark:hover:opacity-100">
                {link.label}
              </a>
            </li>
          ))}
        </ul>
      ))}
    </div>
  </div>

  <!-- Full-width divider & All rights reserved -->
  <div class="w-full border-t border-white/15 dark:border-black/15 bg-black/10 dark:bg-black/5 py-4 md:py-5">
    <div class="mx-auto max-w-6xl px-4 sm:px-6 lg:px-8 flex items-center justify-center text-center">
      <p class="text-center text-sm font-medium text-white/90 dark:text-black/90">
        &copy; {new Date().getFullYear()} Animus Project. All rights reserved.
      </p>
    </div>
  </div>
</footer>

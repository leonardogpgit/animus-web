---
import { FOOTER_LINKS, BRAND_NAME, BRAND_LOGO_TEXT, SOCIAL_LINKS } from '../config';
import { resolvePath } from '../utils/navigation';
---

<footer class="bg-white dark:bg-[#09090b] border-t border-slate-200 dark:border-slate-800 pt-16 pb-12 transition-colors">
  <div class="container mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 gap-10 md:grid-cols-2 lg:grid-cols-[2fr_1fr_1fr_auto] lg:gap-12 mb-12">
      <!-- Brand & Direct Download CTA -->
      <div>
        <a href={resolvePath('/')} class="flex items-center gap-2.5 mb-5">
          <div class="w-9 h-9 bg-primary-600 dark:bg-primary-500 rounded-xl flex items-center justify-center shadow-sm shadow-primary-500/30">
            <span class="text-white font-bold text-sm leading-none">{BRAND_LOGO_TEXT}</span>
          </div>
          <span class="font-sans font-bold text-sm tracking-tight text-black dark:text-white">{BRAND_NAME}</span>
        </a>
        <div class="flex flex-wrap items-center gap-3">
          <a
            href="https://app.animusproject.org"
            class="inline-flex items-center gap-2 px-4 py-2.5 rounded-xl bg-primary-600 hover:bg-primary-500 text-white font-medium text-sm shadow-sm shadow-primary-500/25 transition-all duration-200 hover:-translate-y-0.5"
          >
            <span>Download Mobile App</span>
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M7 17l9.2-9.2M17 17V7H7"/></svg>
          </a>
        </div>
      </div>

      <!-- Links (without section subtitles) -->
      {FOOTER_LINKS.map(group => (
        <div>
          <ul class="space-y-3">
            {group.links.map(link => (
              <li>
                <a href={resolvePath(link.href)} class="text-sm text-black dark:text-white hover:text-primary-600 dark:hover:text-primary-400 transition-colors">
                  {link.label}
                </a>
              </li>
            ))}
          </ul>
        </div>
      ))}

      <!-- Social Icons -->
      <div class="flex items-start md:justify-end">
        <a href={SOCIAL_LINKS.twitter} class="flex h-9 w-9 items-center justify-center rounded-lg border border-slate-200 bg-slate-100 text-black hover:bg-slate-200 dark:border-white/10 dark:bg-white/5 dark:text-white dark:hover:bg-white/10 transition-colors" target="_blank" rel="noopener noreferrer" aria-label="X (Twitter)">
          <span class="sr-only">X (Twitter)</span>
          <svg class="h-4 w-4" fill="currentColor" viewBox="0 0 24 24"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/></svg>
        </a>
      </div>
    </div>

    <div class="border-t border-slate-200 dark:border-slate-800 pt-8 flex items-center justify-center text-center">
      <p class="text-sm text-black dark:text-white text-center">
        &copy; {new Date().getFullYear()} {BRAND_NAME} Project. All rights reserved.
      </p>
    </div>
  </div>
</footer>

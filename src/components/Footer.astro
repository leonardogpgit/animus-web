---
import { FOOTER_LINKS, SOCIAL_LINKS } from '../config';
import { resolvePath } from '../utils/navigation';
---

<footer class="bg-[#e6ecf2] dark:bg-[#09090b] border-t border-slate-300 dark:border-slate-800 pt-6 pb-4 md:pt-8 md:pb-5 transition-colors">
  <div class="container mx-auto px-4 sm:px-6 lg:px-8">
    <!-- Social Icons (dedicated line above legal) -->
    <div class="flex flex-wrap items-center justify-center gap-2 sm:gap-3 mb-3 md:mb-4">
      {SOCIAL_LINKS.map(item => (
        <a
          href={item.url}
          class="flex h-9 w-9 items-center justify-center rounded-lg border border-slate-300 bg-[#f4f7fb] text-black shadow-xs hover:bg-slate-200 dark:border-white/10 dark:bg-white/5 dark:text-white dark:hover:bg-white/10 transition-colors"
          target="_blank"
          rel="noopener noreferrer"
          aria-label={item.label}
          title={item.label}
        >
          <span class="sr-only">{item.label}</span>
          <svg class="h-4 w-4" fill="currentColor" viewBox="0 0 24 24">
            <path d={item.path} />
          </svg>
        </a>
      ))}
    </div>

    <!-- Legal Links -->
    <div class="flex flex-wrap items-center justify-center gap-6 mb-4 md:mb-5">
      {FOOTER_LINKS.map(group => (
        <ul class="flex flex-wrap items-center justify-center gap-6">
          {group.links.map(link => (
            <li>
              <a href={resolvePath(link.href)} class="text-sm text-black dark:text-white hover:text-primary-600 dark:hover:text-primary-400 transition-colors">
                {link.label}
              </a>
            </li>
          ))}
        </ul>
      ))}
    </div>

    <div class="border-t border-slate-300 dark:border-slate-800 pt-4 md:pt-5 flex items-center justify-center text-center">
      <p class="text-sm text-black dark:text-white text-center">
        &copy; {new Date().getFullYear()} Animus Project. All rights reserved.
      </p>
    </div>
  </div>
</footer>

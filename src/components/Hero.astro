---
import Button from './Button.astro';
---

<section class="relative flex min-h-[calc(100svh-4rem)] flex-col items-center justify-between pt-16 pb-10 sm:pt-28 sm:pb-14 lg:pt-36 lg:pb-16 overflow-hidden">
  <!-- Clean Background -->
  <div class="absolute inset-0 -z-10 bg-[#e6ecf2] dark:bg-[#09090b]"></div>
  
  <div class="container mx-auto my-auto px-4 sm:px-6 lg:px-8 text-center reveal-on-scroll">
    
    <h1 class="text-3xl sm:text-6xl lg:text-7xl xl:text-8xl font-descscor font-extrabold tracking-tight text-black dark:text-white mb-6 sm:mb-8 max-w-5xl mx-auto leading-[1.12] sm:leading-[1.08]">
      What do you think? <br/><span class="text-gradient font-descscor">The mind of humanity in real time.</span>
    </h1>
    
    <p class="text-base sm:text-lg md:text-xl text-black dark:text-white mb-8 sm:mb-12 max-w-2xl mx-auto font-sans leading-relaxed">
      An open, anonymous network for human consensus. Answer questions to see demographic breakdowns, earn credits to ask your own, and explore unfiltered perspectives.
    </p>
    
    <div class="flex flex-col sm:flex-row items-center justify-center gap-3.5 sm:gap-4">
      <Button href="https://app.animusproject.org" variant="primary" size="lg" class="w-full sm:w-auto text-base sm:text-lg px-8 py-4 shadow-xl shadow-black/10">
        Get the Mobile App
      </Button>
      <Button href="#features" variant="outline" size="lg" class="w-full sm:w-auto text-base sm:text-lg px-8 py-4 bg-[#f4f7fb] dark:bg-slate-900/50">
        How It Works
      </Button>
    </div>
  </div>

  <a
    href="#features"
    aria-label="Scroll down"
    class="relative z-10 mt-10 inline-flex h-10 w-10 items-center justify-center rounded-xl text-black/60 transition-colors hover:text-black dark:text-white/60 dark:hover:text-white animate-bounce"
  >
    <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
      <polyline points="6 9 12 15 18 9"></polyline>
    </svg>
  </a>
</section>

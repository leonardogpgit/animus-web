---
interface Props {
  variant?: 'primary' | 'success' | 'warning' | 'error' | 'neutral';
  class?: string;
}

const { variant = 'primary', class: className = '' } = Astro.props;

const baseStyles = "inline-flex items-center px-3 py-1 rounded-full text-xs font-display font-semibold tracking-wide uppercase";

const variants = {
  primary: "bg-slate-200 dark:bg-white/10 text-black dark:text-white border border-slate-300 dark:border-white/20",
  success: "bg-slate-200 dark:bg-white/10 text-black dark:text-white border border-slate-300 dark:border-white/20",
  warning: "bg-slate-200 dark:bg-white/10 text-black dark:text-white border border-slate-300 dark:border-white/20",
  error: "bg-slate-200 dark:bg-white/10 text-black dark:text-white border border-slate-300 dark:border-white/20",
  neutral: "bg-slate-100 dark:bg-white/10 text-black dark:text-white border border-slate-300 dark:border-white/20",
};

const combinedClasses = `${baseStyles} ${variants[variant]} ${className}`;
---

<span class={combinedClasses}>
  <slot />
</span>
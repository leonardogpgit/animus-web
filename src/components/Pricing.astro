---
import Button from './Button.astro';
import Badge from './Badge.astro';
---

<section id="pricing" class="py-28 bg-slate-50 dark:bg-[#0c0c0f] border-t border-slate-200 dark:border-slate-800">
  <div class="container mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
    <div class="text-center max-w-3xl mx-auto mb-16 reveal-on-scroll">
      <span class="inline-flex items-center gap-2 px-3 py-1 rounded-full border border-primary-300 dark:border-primary-500/30 bg-primary-50 dark:bg-primary-500/10 text-primary-600 dark:text-primary-400 text-xs font-semibold uppercase tracking-widest mb-4">
        Participation Model
      </span>
      <h2 class="text-4xl md:text-5xl font-heading font-extrabold text-slate-900 dark:text-white mb-6">
        100% Free to use. <br/><span class="text-slate-400 dark:text-slate-500">Powered by reciprocity.</span>
      </h2>
      <p class="text-lg sm:text-xl text-slate-600 dark:text-slate-400">
        No subscription fees. No paywalls. Your answers grant you the right to ask, boost, and explore.
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8 max-w-6xl mx-auto">
      <!-- Voice Tier -->
      <div class="glass-panel p-8 flex flex-col reveal-on-scroll">
        <h3 class="text-2xl font-heading font-bold text-slate-900 dark:text-white mb-2">Everyday Voice</h3>
        <p class="text-slate-500 dark:text-slate-400 text-sm mb-6">Open, authentic expression for everyone.</p>
        <div class="mb-8">
          <span class="text-5xl font-heading font-extrabold text-slate-900 dark:text-white">Free</span>
          <span class="text-slate-500 dark:text-slate-400 font-medium"> / forever</span>
        </div>
        <Button href="https://app.animusproject.org" variant="outline" class="w-full mb-8 font-heading">Download Free</Button>
        <ul class="space-y-4 text-sm text-slate-600 dark:text-slate-300 flex-grow font-sans">
          <li class="flex gap-3"><svg class="h-5 w-5 text-primary-500 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" /></svg> Full access to answer daily questions</li>
          <li class="flex gap-3"><svg class="h-5 w-5 text-primary-500 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" /></svg> Zero personal tracking or ads</li>
          <li class="flex gap-3"><svg class="h-5 w-5 text-primary-500 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" /></svg> Instant demographic consensus upon answering</li>
          <li class="flex gap-3"><svg class="h-5 w-5 text-primary-500 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" /></svg> Earn participation credits with every response</li>
          <li class="flex gap-3"><svg class="h-5 w-5 text-primary-500 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" /></svg> Native Android & iOS support</li>
        </ul>
      </div>

      <!-- Ask & Boost Tier -->
      <div class="glass-panel border-2 border-primary-500 dark:border-primary-500 p-8 flex flex-col relative transform lg:-translate-y-4 shadow-2xl shadow-primary-500/10 reveal-on-scroll" style="transition-delay: 100ms;">
        <div class="absolute -top-4 left-1/2 -translate-x-1/2">
          <Badge variant="primary" class="px-4 py-1.5 font-bold shadow-sm font-heading">Core Engine</Badge>
        </div>
        <h3 class="text-2xl font-heading font-bold text-slate-900 dark:text-white mb-2 mt-2">Ask & Boost</h3>
        <p class="text-slate-500 dark:text-slate-400 text-sm mb-6">Elevate your questions to the wider world.</p>
        <div class="mb-8">
          <span class="text-4xl sm:text-5xl font-heading font-extrabold text-slate-900 dark:text-white">Credits</span>
          <span class="text-slate-500 dark:text-slate-400 font-medium text-xs sm:text-sm"> / earned</span>
        </div>
        <Button href="https://app.animusproject.org" variant="primary" class="w-full mb-8 font-heading">Earn in the App</Button>
        <ul class="space-y-4 text-sm text-slate-600 dark:text-slate-300 flex-grow font-sans">
          <li class="flex gap-3"><svg class="h-5 w-5 text-primary-500 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" /></svg> Post your own custom dilemmas</li>
          <li class="flex gap-3"><svg class="h-5 w-5 text-primary-500 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" /></svg> Duplicate questions merged into single nodes</li>
          <li class="flex gap-3"><svg class="h-5 w-5 text-primary-500 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" /></svg> Boost questions to reach wider demographics</li>
          <li class="flex gap-3"><svg class="h-5 w-5 text-primary-500 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" /></svg> Climb community reputation boards</li>
          <li class="flex gap-3"><svg class="h-5 w-5 text-primary-500 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" /></svg> Tradable participation currency in the future</li>
        </ul>
      </div>

      <!-- Communities Tier -->
      <div class="glass-panel p-8 flex flex-col reveal-on-scroll" style="transition-delay: 200ms;">
        <h3 class="text-2xl font-heading font-bold text-slate-900 dark:text-white mb-2">Custom Groups</h3>
        <p class="text-slate-500 dark:text-slate-400 text-sm mb-6">For universities, collectives, and creators.</p>
        <div class="mb-8">
          <span class="text-5xl font-heading font-extrabold text-slate-900 dark:text-white">Open</span>
          <span class="text-slate-500 dark:text-slate-400 font-medium"> / spaces</span>
        </div>
        <Button href="https://x.com/animusproject" variant="outline" class="w-full mb-8 font-heading">Contact the Project</Button>
        <ul class="space-y-4 text-sm text-slate-600 dark:text-slate-300 flex-grow font-sans">
          <li class="flex gap-3"><svg class="h-5 w-5 text-primary-500 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" /></svg> Create targeted question batches</li>
          <li class="flex gap-3"><svg class="h-5 w-5 text-primary-500 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" /></svg> Direct shareable link for participants</li>
          <li class="flex gap-3"><svg class="h-5 w-5 text-primary-500 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" /></svg> Instant aggregated group consensus</li>
          <li class="flex gap-3"><svg class="h-5 w-5 text-primary-500 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" /></svg> Zero questionnaire fatigue</li>
          <li class="flex gap-3"><svg class="h-5 w-5 text-primary-500 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" /></svg> Participants discover the broader network</li>
        </ul>
      </div>
    </div>
  </div>
</section>
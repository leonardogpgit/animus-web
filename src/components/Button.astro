---
import type { HTMLAttributes } from 'astro/types';

interface Props extends HTMLAttributes<'button'> {
  href?: string;
  variant?: 'primary' | 'secondary' | 'outline' | 'ghost';
  size?: 'sm' | 'md' | 'lg';
  class?: string;
}

const { href, variant = 'primary', size = 'md', class: className, ...props } = Astro.props;

const baseStyles = "inline-flex items-center justify-center font-display font-medium rounded-xl transition-all duration-200 focus:outline-none focus:ring-2 focus:ring-offset-2 dark:focus:ring-offset-slate-900 active:scale-[0.98]";

const variants = {
  primary: "bg-black dark:bg-white text-white dark:text-black hover:bg-black/85 dark:hover:bg-white/85 focus:ring-black dark:focus:ring-white shadow-sm",
  secondary: "bg-slate-800 dark:bg-slate-200 text-white dark:text-black hover:bg-slate-700 dark:hover:bg-slate-300 focus:ring-slate-800 dark:focus:ring-slate-200 shadow-sm",
  outline: "border border-slate-400 dark:border-white/20 bg-[#f4f7fb] dark:bg-transparent text-black dark:text-white hover:border-slate-600 dark:hover:border-white/40 hover:bg-slate-200/60 dark:hover:bg-white/10 focus:ring-slate-500 shadow-xs",
  ghost: "text-black dark:text-white hover:bg-slate-200 dark:hover:bg-slate-800 focus:ring-slate-500",
};

const sizes = {
  sm: "px-4 py-2 text-sm",
  md: "px-6 py-2.5 text-base",
  lg: "px-8 py-3.5 text-lg",
};

const Element = href ? 'a' : 'button';
const combinedClasses = `${baseStyles} ${variants[variant]} ${sizes[size]} ${className || ''}`;
---

<Element href={href} class={combinedClasses} {...props}>
  <slot />
</Element>
---
import BaseLayout from '../layouts/BaseLayout.astro';
import PricingComponent from '../components/Pricing.astro';
---

<BaseLayout title="Participation & Access" description="100% free forever. Understand the Animus reciprocity and credit model.">
  <div class="bg-slate-50 dark:bg-[#0c0c0f] border-b border-slate-200 dark:border-slate-800 py-16 md:py-24 transition-colors">
    <div class="container mx-auto px-4 sm:px-6 lg:px-8 max-w-4xl text-center">
      <h1 class="text-4xl md:text-5xl font-heading font-extrabold text-slate-900 dark:text-white mb-4">Participation & Access</h1>
      <p class="text-lg sm:text-xl text-slate-600 dark:text-slate-400 max-w-2xl mx-auto">
        Animus is powered by human contribution, not credit cards. Answer to reveal consensus and earn the right to elevate your own questions.
      </p>
    </div>
  </div>

  <PricingComponent />
  
</BaseLayout>
